---
import { withBase } from '../lib/url';
import '../styles/contact.css';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us | Divine Fly Fishing — Connect for Your Adventure" description="Reach out to Divine Fly Fishing for customized itineraries, bookings, and inquiries about our fly fishing trips in Bhutan." current="contact">
<!-- ========= CONTACT HERO ========= -->
  <header class="page-hero" style={`background-image: url('${withBase('/assets/images/heroes/contact.webp')}');`}>
    <div class="hero-overlay"></div>
    <div class="container slide-up">
      <h1>Contact Us</h1>
      <nav class="breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span>/</span>
        <span style="color: #fdfcfb;">Contact</span>
      </nav>
    </div>
  </header>

  <!-- ========= CONTACT MAIN SECTION ========= -->
  <section class="contact-wrapper">
    <div class="container">
      <div class="contact-grid-main">
        
        <!-- Info Side -->
        <div class="contact-info-side">
          <span class="sub-label">Information</span>
          <h2>Reach Out To The <br /><em>Kingdom</em></h2>
          <p class="section-body" style="margin-top: 20px;">We specialize in deeply personalized experiences. Drop us a line, and our head guide will respond to help craft your perfect itinerary.</p>
          
          <div class="contact-info-list text-left">
            
            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="info-text">
                <h4>Our Base</h4>
                <p>Above Mitsubishi Showroom, <br />Babesa Expressway, Babesa, <br />Thimphu, Bhutan</p>
              </div>
            </div>

            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div class="info-text">
                <h4>Email Inquiries</h4>
                <a href="mailto:tightlines@divineflyfishing.com">tightlines@divineflyfishing.com</a>
              </div>
            </div>

            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="info-text">
                <h4>WhatsApp / Mobile</h4>
                <a href="tel:+97517113511">+975 - 17113511</a>
                <p style="font-size: 0.85rem; margin-top: 5px;">(Preferred for quick consultation)</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Form Side -->
        <div class="contact-form-side">
          <div class="contact-form-card">
            <h3 style="font-family: var(--font-heading); font-size: 2rem; margin-bottom: 35px; color: #1a1a1a;">Send Us A Message</h3>
            <form action="#" id="contactForm">
              <div class="form-group-grid">
                <div class="form-field">
                  <label>First Name</label>
                  <input type="text" placeholder="e.g. Tashi" required />
                </div>
                <div class="form-field">
                  <label>Last Name</label>
                  <input type="text" placeholder="e.g. Dorji" required />
                </div>
              </div>
              
              <div class="form-group-grid">
                <div class="form-field">
                  <label>Email Address</label>
                  <input type="email" placeholder="email@example.com" required />
                </div>
                <div class="form-field">
                  <label>Contact Number</label>
                  <input type="tel" placeholder="+975-XXXXXXXX" required />
                </div>
              </div>

              <div class="form-field">
                <label>I'm interested in...</label>
                <select required>
                  <option value="" disabled selected>Select a package</option>
                  <option value="haa-valley">Haa Valley</option>
                  <option value="paro-valley">Paro Valley</option>
                  <option value="phobjikha-valley">Phobjikha Valley</option>
                  <option value="bumthang-valley">Bumthang Valley</option>
                  <option value="general">General Inquiry</option>
                </select>
              </div>

              <div class="form-field">
                <label>Your Message</label>
                <textarea rows="5" placeholder="Leave us a message..."></textarea>
              </div>

              <button type="submit" class="btn-submit">
                <span>Request Details</span>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========= FOOTER ========= -->
</Layout>

