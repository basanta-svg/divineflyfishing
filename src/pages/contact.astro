---
import { withBase } from '../lib/url';
import '../styles/contact.css';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us | Divine Fly Fishing — Connect for Your Adventure" description="Reach out to Divine Fly Fishing for customized itineraries, bookings, and inquiries about our fly fishing trips in Bhutan." current="contact">
<!-- ========= CONTACT HERO ========= -->
  <header class="page-hero" style={`background-image: url('${withBase('/assets/images/heroes/contact.webp')}');`}>
    <div class="hero-overlay"></div>
    <div class="container slide-up">
      <h1>Contact Us</h1>
      <nav class="breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span>/</span>
        <span style="color: #fdfcfb;">Contact</span>
      </nav>
    </div>
  </header>

  <!-- ========= CONTACT MAIN SECTION ========= -->
  <section class="contact-wrapper">
    <div class="container">
      <div class="contact-grid-main">
        
        <!-- Info Side -->
        <div class="contact-info-side">
          <span class="sub-label">Information</span>
          <h2>Reach Out To The <br /><em>Kingdom</em></h2>
          <p class="section-body" style="margin-top: 20px;">We specialize in deeply personalized experiences. Drop us a line, and our head guide will respond to help craft your perfect itinerary.</p>
          
          <div class="contact-info-list text-left">
            
            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="info-text">
                <h4>Our Base</h4>
                <p>Thagzo Lam, <br />Chubachu, <br />Thimphu - 11001, Bhutan</p>
              </div>
            </div>

            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div class="info-text">
                <h4>Email Inquiries</h4>
                <a href="mailto:tightlines@divineflyfishing.com">tightlines@divineflyfishing.com</a>
              </div>
            </div>

            <div class="info-block">
              <div class="info-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="info-text">
                <h4>WhatsApp / Mobile</h4>
                <a href="tel:+97517113511">+975 - 17113511</a>
                <p style="font-size: 0.85rem; margin-top: 5px;">(Preferred for quick consultation)</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Form Side -->
        <div class="contact-form-side">
          <div class="contact-form-card">
            <h3 style="font-family: var(--font-heading); font-size: 2rem; margin-bottom: 35px; color: #1a1a1a;">Send Us A Message</h3>
            <form action="#" id="contactForm">
              <div class="form-group-grid">
                <div class="form-field">
                  <label>First Name</label>
                  <input type="text" placeholder="e.g. Tashi" required />
                </div>
                <div class="form-field">
                  <label>Last Name</label>
                  <input type="text" placeholder="e.g. Dorji" required />
                </div>
              </div>
              
              <div class="form-group-grid">
                <div class="form-field">
                  <label>Email Address</label>
                  <input type="email" placeholder="email@example.com" required />
                </div>
                <div class="form-field">
                  <label>Contact Number</label>
                  <input type="tel" placeholder="+975-XXXXXXXX" required />
                </div>
              </div>

              <div class="form-field">
                <label>I'm interested in...</label>
                <select required data-custom-select>
                  <option value="" disabled selected>Select a package</option>
                  <option value="haa-valley">Haa Valley</option>
                  <option value="paro-valley">Paro Valley</option>
                  <option value="phobjikha-valley">Phobjikha Valley</option>
                  <option value="bumthang-valley">Bumthang Valley</option>
                  <option value="general">General Inquiry</option>
                </select>
              </div>

              <div class="form-field">
                <label>Your Message</label>
                <textarea rows="5" placeholder="Leave us a message..."></textarea>
              </div>

              <button type="submit" class="btn-submit">
                <span>Request Details</span>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========= MAP ========= -->
  <section class="contact-map">
    <div class="container">
      <div class="contact-map-frame">
        <iframe
          title="Divine Fly Fishing location — Thagzo Lam, Chubachu, Thimphu"
          src="https://maps.google.com/maps?q=27.4775666,89.6373771&z=17&output=embed"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
      <a class="contact-map-link" href="https://maps.app.goo.gl/pd5U51n1j75fjyxq9" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
    </div>
  </section>


  <!-- ========= FOOTER ========= -->
</Layout>

<script>
  // Custom-styled dropdown that mirrors the native <select> (kept for validation/submit).
  document.querySelectorAll<HTMLSelectElement>('select[data-custom-select]').forEach((select) => {
    const wrap = document.createElement('div');
    wrap.className = 'cselect';
    select.parentNode!.insertBefore(wrap, select);
    wrap.appendChild(select);
    select.classList.add('cselect-native');
    select.tabIndex = -1;

    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'cselect-trigger';
    trigger.setAttribute('aria-haspopup', 'listbox');
    trigger.setAttribute('aria-expanded', 'false');
    const label = document.createElement('span');
    trigger.appendChild(label);
    trigger.insertAdjacentHTML('beforeend', '<svg class="cselect-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>');

    const list = document.createElement('ul');
    list.className = 'cselect-list';
    list.setAttribute('role', 'listbox');

    const items: HTMLLIElement[] = [];
    Array.from(select.options).forEach((opt, i) => {
      if (opt.disabled) return;
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.dataset.index = String(i);
      li.textContent = opt.textContent;
      li.addEventListener('click', () => { choose(i); close(); trigger.focus(); });
      list.appendChild(li);
      items.push(li);
    });

    wrap.append(trigger, list);

    function sync() {
      const opt = select.options[select.selectedIndex];
      const placeholder = !select.value;
      label.textContent = opt ? opt.textContent : '';
      trigger.classList.toggle('is-placeholder', placeholder);
      items.forEach((li) => {
        const on = Number(li.dataset.index) === select.selectedIndex && !placeholder;
        li.classList.toggle('is-selected', on);
        li.setAttribute('aria-selected', String(on));
      });
    }
    function choose(i: number) {
      select.selectedIndex = i;
      select.dispatchEvent(new Event('change', { bubbles: true }));
      sync();
    }
    function open() { wrap.classList.add('is-open'); trigger.setAttribute('aria-expanded', 'true'); }
    function close() { wrap.classList.remove('is-open'); trigger.setAttribute('aria-expanded', 'false'); }

    trigger.addEventListener('click', () => (wrap.classList.contains('is-open') ? close() : open()));
    document.addEventListener('click', (e) => { if (!wrap.contains(e.target as Node)) close(); });
    wrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { close(); trigger.focus(); return; }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        open();
        const cur = items.findIndex((li) => Number(li.dataset.index) === select.selectedIndex);
        const next = e.key === 'ArrowDown' ? Math.min(items.length - 1, cur + 1) : Math.max(0, cur - 1);
        choose(Number(items[next].dataset.index));
      }
    });
    select.form?.addEventListener('reset', () => setTimeout(sync));
    select.addEventListener('invalid', () => trigger.classList.add('is-invalid'));
    select.addEventListener('change', () => trigger.classList.remove('is-invalid'));
    sync();
  });
</script>

