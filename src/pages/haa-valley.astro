---
import { withBase } from '../lib/url';
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/packages.css';
import '../styles/haa-valley.css';
---
<Layout title="Haa Valley Package — High Altitude Fly Fishing | Divine Fly Fishing" description="Experience a 7-day technical fly fishing journey in the pristine Haa Valley. Discover the art of stalking Brown Trout in crystal-clear mountain streams." current="packages">
<header class="page-hero" style={`background-image: url('${withBase('/assets/images/heroes/haa.webp')}');`}>
    <div class="hero-overlay"></div>
    <div class="container slide-up">
      <h1>Haa Valley Journey</h1>
      <nav class="breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span>/</span>
        <a href={withBase('/packages/')}>Packages</a>
        <span>/</span>
        <span style="color: #fdfcfb;">Haa Valley</span>
      </nav>
    </div>
  </header>

  <!-- ========= OVERVIEW ========= -->
  <section class="hv-overview" id="overview">
    <div class="container hv-overview-grid">
      <div class="hv-overview-text">
        <span class="sub-label">The Technical Pursuits</span>
        <h2>The Art of Fishing the Haa Valley</h2>
        <p>Fishing in Haa is a test of stealth and precision. The water is often so clear that the Brown Trout can spot your silhouette from yards away. It requires a quiet soul and a strategic mind.</p>
        <ul class="hv-stats">
          <li><strong>7</strong><span>Days</span></li>
          <li><strong>Mar–Oct</strong><span>Season</span></li>
          <li><strong>3–5 wt</strong><span>Rods</span></li>
          <li><strong>3</strong><span>Species</span></li>
        </ul>
      </div>
      <div class="hv-collage">
        <Img class="hv-collage-a" src="/assets/images/heroes/haa.webp" alt="Haa Valley" loading="lazy" />
        <Img class="hv-collage-b" src="/assets/images/photos/full/y48c8787.webp" alt="Fishing the Haa Chhu" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ========= FISHING FACTS ========= -->
  <section class="hv-fishing" id="fishing">
    <div class="container">
      <div class="hv-heading">
        <span class="sub-label">On the Water</span>
        <h2>How We Fish Haa</h2>
      </div>
      <div class="hv-facts">
        <div class="hv-fact">
          <span class="hv-fact-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg></span>
          <h4>Skill Level</h4>
          <p>Intermediate to Advanced. Master low-profile approaches.</p>
        </div>
        <div class="hv-fact">
          <span class="hv-fact-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" /><line x1="16" y1="8" x2="2" y2="22" /><line x1="17.5" y1="15" x2="9" y2="15" /></svg></span>
          <h4>Equipment</h4>
          <p>3wt to 5wt rods with floating lines. Small dries.</p>
        </div>
        <div class="hv-fact">
          <span class="hv-fact-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8l4 4-4 4M8 12h7" /></svg></span>
          <h4>Methodology</h4>
          <p>Tactical wading and "Stalk &amp; Cast" methodology.</p>
        </div>
        <div class="hv-fact">
          <span class="hv-fact-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12s-4.44-7-10-7-10 7-10 7 4.44 7 10 7 10-7 10-7z" /><circle cx="12" cy="12" r="3" /></svg></span>
          <h4>Target Species</h4>
          <p>Brown Trout, Snow Trout, Rainbow Trout.</p>
        </div>
        <div class="hv-fact">
          <span class="hv-fact-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></span>
          <h4>Best Months</h4>
          <p>Peak window: March – October.</p>
        </div>
      </div>
      <div class="hv-slider">
        <button class="hv-slide-btn hv-slide-prev" type="button" aria-label="Previous photos">&#10094;</button>
        <div class="hv-shots" id="hvShots">
          <button class="hv-shot" aria-label="Open photo 1"><Img src="/assets/images/heroes/haa.webp" alt="Haa Valley landscape" loading="lazy" /></button>
          <button class="hv-shot" aria-label="Open photo 2"><Img src="/assets/images/photos/full/img-3294.webp" alt="Fly fishing the Haa Chhu" loading="lazy" /></button>
          <button class="hv-shot" aria-label="Open photo 3"><Img src="/assets/images/photos/full/img-9769-edited.webp" alt="Angler in the river" loading="lazy" /></button>
          <button class="hv-shot" aria-label="Open photo 4"><Img src="/assets/images/photos/full/img-3235.webp" alt="Brown trout catch" loading="lazy" /></button>
        </div>
        <button class="hv-slide-btn hv-slide-next" type="button" aria-label="Next photos">&#10095;</button>
      </div>
    </div>
  </section>

  <!-- ========= ITINERARY SECTION ========= -->
  <section class="hv-itinerary" id="itinerary">
    <div class="container">
      <div class="hv-heading">
        <span class="sub-label">7-Day Technical Journey</span>
        <h2>Detailed Itinerary</h2>
      </div>
      <div class="hv-acc">
        <div class="hv-acc-item is-open">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="true" aria-controls="hv-day-1" id="hv-head-1">
              <span class="hv-acc-day">Day 01</span>
              <span class="hv-acc-title">Arrival & Valley Serenity</span>
              <span class="hv-acc-tag">Paro → Haa</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-1" role="region" aria-labelledby="hv-head-1">
            <div class="hv-acc-body"><p>Arrive at Paro International Airport. After processing visas, we take a scenic 2-hour drive through the pine forests to Haa Valley. Evening acclimatization and gear setup at the lodge.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-2" id="hv-head-2">
              <span class="hv-acc-day">Day 02</span>
              <span class="hv-acc-title">First Cast: The Lower Haa Chhu</span>
              <span class="hv-acc-tag">Lower Haa Chhu</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-2" role="region" aria-labelledby="hv-head-2">
            <div class="hv-acc-body"><p>A gentle introduction to Haa's waters. We focus on the wider stretches of the lower river, practicing low-profile wading and reading the currents for local Brown Trout.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-3" id="hv-head-3">
              <span class="hv-acc-day">Day 03</span>
              <span class="hv-acc-title">The Upper Reaches & Stalking Tactics</span>
              <span class="hv-acc-tag">Upper valley</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-3" role="region" aria-labelledby="hv-head-3">
            <div class="hv-acc-body"><p>Heading deep into the upper valley. This is technical water. We use stealth and 12ft leaders to fool the larger, spookier fish in the crystal-clear pools.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-4" id="hv-head-4">
              <span class="hv-acc-day">Day 04</span>
              <span class="hv-acc-title">Tributary Exploration</span>
              <span class="hv-acc-tag">Hidden tributaries</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-4" role="region" aria-labelledby="hv-head-4">
            <div class="hv-acc-body"><p>Exploring the tiny, hidden tributaries. This day is about nimble casting and high-adrenaline sight-fishing in narrow pockets of water.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-5" id="hv-head-5">
              <span class="hv-acc-day">Day 05</span>
              <span class="hv-acc-title">Cultural Immersion & Evening Hatch</span>
              <span class="hv-acc-tag">Temples & hatch</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-5" role="region" aria-labelledby="hv-head-5">
            <div class="hv-acc-body"><p>A morning visit to the White and Black Temples (Lhakhang Karpo and Nagpo). The afternoon is spent resting before one of the most intense evening hatches of the week.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-6" id="hv-head-6">
              <span class="hv-acc-day">Day 06</span>
              <span class="hv-acc-title">The Canyon Deep: Final Challenge</span>
              <span class="hv-acc-tag">Canyon stretches</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-6" role="region" aria-labelledby="hv-head-6">
            <div class="hv-acc-body"><p>A trek into the deeper canyon stretches. High risk, high reward. A final day of master-class fly fishing before a celebratory dinner.</p></div>
          </div>
        </div>
        <div class="hv-acc-item">
          <h3>
            <button class="hv-acc-head" type="button" aria-expanded="false" aria-controls="hv-day-7" id="hv-head-7">
              <span class="hv-acc-day">Day 07</span>
              <span class="hv-acc-title">Farewell to the Valley</span>
              <span class="hv-acc-tag">Haa → Paro</span>
              <span class="hv-acc-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="hv-acc-panel" id="hv-day-7" role="region" aria-labelledby="hv-head-7">
            <div class="hv-acc-body"><p>Morning transfers back to Paro. Final souvenir shopping and departure flight.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========= INCLUDED / EXCLUDED ========= -->
  <section class="hv-details" id="included">
    <div class="container">
      <div class="hv-heading">
        <span class="sub-label">Plan with Confidence</span>
        <h2>What's Included</h2>
      </div>
      <div class="hv-details-grid">
        <div class="hv-box hv-in">
          <h3>Included</h3>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg><span>Full Bhutanese Visa &amp; Sustainable Fee</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg><span>Professional Fly Fishing Guides</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg><span>All Internal Transfers &amp; Logistics</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg><span>Heritage Lodge Accommodations</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg><span>All Meals &amp; Local Drinks</span></li>
          </ul>
        </div>
        <div class="hv-box hv-out">
          <h3>Not Included</h3>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12" /></svg><span>International Flights</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Personal Fishing Tackle</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Travel Insurance</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12" /></svg><span>Tips for Guides &amp; Staff</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========= BOOKING ========= -->
  <section class="hv-book" id="book">
    <div class="container hv-book-grid">
      <div class="hv-book-text">
        <span class="sub-label">Reserve Your Spot</span>
        <h2>Secure Your Haa Valley Journey</h2>
        <p>Secure your technical fly fishing journey today. Our team will contact you within 24 hours to discuss seasonal availability and gear requirements.</p>
        <ul class="hv-contact">
          <li><a href="tel:+97517113511">+975 17113511</a></li>
          <li><a href="mailto:tightlines@divineflyfishing.com">tightlines@divineflyfishing.com</a></li>
          <li><a href="https://wa.me/97517113511" target="_blank" rel="noopener noreferrer">WhatsApp Chat</a></li>
        </ul>
      </div>
      <form class="hv-form" id="haaPackageForm">
        <div class="hv-field"><label>Selected Package</label><input type="text" value="Haa Valley Package" readonly></div>
        <div class="hv-row">
          <div class="hv-field"><label>Full Name</label><input type="text" placeholder="John Doe" required></div>
          <div class="hv-field"><label>Email Address</label><input type="email" placeholder="john@example.com" required></div>
        </div>
        <div class="hv-row">
          <div class="hv-field"><label>Phone Number</label><input type="tel" placeholder="+975 17 00 00 00" required></div>
          <div class="hv-field"><label>Booking Date</label><input type="date" required></div>
        </div>
        <div class="hv-field"><label>Number of Fishermen</label><input type="number" min="1" max="10" value="1"></div>
        <div class="hv-field"><label>Special Requirements / Notes</label><textarea rows="4" placeholder="Mention any gear rental needs or dietary preferences..."></textarea></div>
        <button type="submit" class="hv-submit" id="submitBtn">Send Booking Inquiry</button>
      </form>
    </div>
  </section>

  <!-- ========= PHOTO LIGHTBOX ========= -->
  <div class="hv-lightbox" id="hvLightbox" aria-hidden="true">
    <button class="hv-lb-close" id="hvClose" aria-label="Close">&times;</button>
    <button class="hv-lb-nav hv-lb-prev" id="hvPrev" aria-label="Previous">&#10094;</button>
    <img id="hvLbImg" src="" alt="" />
    <button class="hv-lb-nav hv-lb-next" id="hvNext" aria-label="Next">&#10095;</button>
  </div>
</Layout>

<script>
  import '../scripts/haa-valley.js';
</script>
