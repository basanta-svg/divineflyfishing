  <!-- ========= IMAGE MODAL LIGHTBOX ========= -->
  <div id="imageModal" class="image-modal">
    <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>
    <button class="modal-nav modal-prev" id="modalPrev" aria-label="Previous image">&#10094;</button>
    <div class="modal-content">
      <img id="modalImg" src="" alt="">
      <video id="modalVideo" controls playsinline></video>
    </div>
    <button class="modal-nav modal-next" id="modalNext" aria-label="Next image">&#10095;</button>
    <div class="modal-counter" id="modalCounter"></div>
  </div>
</Layout>


