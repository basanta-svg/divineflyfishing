---
import { withBase } from '../lib/url';
import '../styles/gallery.css';
import Img from '../components/Img.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Gallery | Divine Fly Fishing — Snapshots of Bhutan's Rivers" description="A visual journey through Bhutan's pristine rivers and legendary fly fishing spots. Experience the kingdom through our gallery." current="gallery">
<!-- ========= GALLERY HERO ========= -->
  <header class="page-hero" style={`background-image: url('${withBase('/assets/images/heroes/gallery.webp')}');`}>
    <div class="hero-overlay"></div>
    <div class="container slide-up">
      <h1>Gallery</h1>
      <nav class="breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span>/</span>
        <span style="color: #fdfcfb;">Gallery</span>
      </nav>
    </div>
  </header>

  <!-- ========= GALLERY GRID ========= -->
