---
import { withBase } from '../lib/url';
import Img from './Img.astro';
---
<footer class="footer-modern" id="contact">
    <div class="container">
      <div class="footer-top-grid">
        <!-- Col 1: Brand & Social -->
        <div class="footer-col footer-brand">
          <a href={withBase('/')} class="footer-logo">
            <img src={withBase('/assets/images/dff-logo.svg')} width="1982" height="1331" alt="Divine Fly Fishing Logo" />
          </a>
          <p class="footer-desc">
            Experience the soul of Bhutan through its pristine waters. We offer curated fly fishing journeys tailored to
            your spirit of adventure.
          </p>
        </div>

        <!-- Col 2: Our Partners -->
        <div class="footer-col footer-partners">
          <h3 class="footer-title">Our Partners</h3>
          <div class="footer-partner-logos">
            <Img src="/assets/images/partners/2.webp" alt="Global Rescue Partner" />
            <Img src="/assets/images/partners/3.webp" alt="Fishing Association" />
          </div>
        </div>

        <!-- Col 3: Contact Info -->
        <div class="footer-col footer-contact-info">
          <h3 class="footer-title">Contact Info</h3>
          <ul class="contact-details">
            <li>
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </span>
              <span class="contact-text">Babesa Expressway, Babesa, Thimphu, Bhutan</span>
            </li>
            <li>
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <a class="contact-text" href="mailto:tightlines@divineflyfishing.com">tightlines@divineflyfishing.com</a>
            </li>
            <li>
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                  </path>
                </svg>
              </span>
              <a class="contact-text" href="tel:+97517113511">+975 17113511</a>
            </li>
            <li>
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              </span>
              <a class="contact-text" href="https://wa.me/97517113511" target="_blank" rel="noopener noreferrer">WhatsApp Chat</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom-bar" style="justify-content: center; text-align: center;">
        <div class="footer-copyright">
          <p>Copyright © 2026 Divine Fly Fishing. All Rights Reserved</p>
          <div class="dev-credit">Website Designed And Developed By <a href="https://abit.bt" target="_blank">aBit
              Private Limited</a></div>
        </div>
      </div>
    </div>
  </footer>
